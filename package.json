{
  "name": "tender-tracker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "SOPS_AGE_KEY_FILE=\"${SOPS_AGE_KEY_FILE:-./key.txt}\" sops exec-env .amanadb-wallet.enc.json \"next dev\"",
    "dev:raw": "next dev",
    "build": "next build",
    "start": "SOPS_AGE_KEY_FILE=\"${SOPS_AGE_KEY_FILE:-./key.txt}\" sops exec-env .amanadb-wallet.enc.json \"next start\"",
    "typecheck": "tsc --noEmit",
    "seed": "SOPS_AGE_KEY_FILE=\"${SOPS_AGE_KEY_FILE:-./key.txt}\" sops exec-env .amanadb-wallet.enc.json \"node --conditions=react-server --import tsx scripts/seed.ts\"",
    "setup": "SOPS_AGE_KEY_FILE=\"${SOPS_AGE_KEY_FILE:-./key.txt}\" sops exec-env .amanadb-wallet.enc.json \"node --conditions=react-server --import tsx scripts/setup.ts\""
  },
  "dependencies": {
    "@amanadb/sdk": "^1.1.1",
    "iron-session": "^9.0.1",
    "next": "^16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
